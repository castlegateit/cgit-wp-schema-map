{
    "name": "castlegate/cgit-wp-schema-map",
    "version": "1.1.0",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "spatie/schema-org": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Castlegate\\SchemaMap\\": "classes"
        }
    },
    "extra": {
        "strauss": {
            "target_directory": "vendor-prefixed",
            "namespace_prefix": "Castlegate\\SchemaMap\\Vendor\\",
            "classmap_prefix": "Castlegate_SchemaMap_Vendor_",
            "packages": [
                "spatie/schema-org"
            ],
            "delete_vendor_packages": true,
            "update_call_sites": true
        }
    },
    "scripts": {
        "strauss-download": "sh -c 'test -f ./bin/strauss.phar || curl -o bin/strauss.phar -L -C - https://github.com/BrianHenryIE/strauss/releases/latest/download/strauss.phar'",
        "prefix-namespaces": [
            "@strauss-download",
            "@php bin/strauss.phar",
            "@composer dump-autoload"
        ],
        "post-install-cmd": [
            "@prefix-namespaces"
        ],
        "post-update-cmd": [
            "@prefix-namespaces"
        ],
        "post-autoload-dump": [
            "@strauss-download",
            "@php bin/strauss.phar include-autoloader"
        ]
    }
}